 "notes": {
  "nominal_center_nm": "Virtual-band centers from the sensor calibration XML (collimated light). Identical in the ROS 1 and ROS 2 repos.",
  "ibex_ros2_logged_center_nm": "Centers reported by the HSI Mosaic pipeline on Ibex (write_camera_lamba.py). Shifted by a constant factor (VNIR x0.9864, SWIR x0.9965, edge bands slightly more), consistent with the Fabry-Perot angle-of-incidence correction computed from optical_setup.xml (VNIR f/1.4, SWIR f/2.8).",
  "hyperdrive_dataset": "Measured with HSI_MOSAIC.GetOutputDataFormat on the ROS 1 contexts (2026-10-20). VNIR identical to the Ibex logged values. SWIR (declared f_number=0) is shifted only slightly from nominal (about x0.9992, -0.9 to -2.5 nm; band 0 equals nominal), so dataset SWIR centers sit about 3.0-4.5 nm above Ibex SWIR centers.",
  "excluded_vnir_filter": "Physical filter index 20 (659.09 nm) is selected=false and has zero coefficients in every virtual band: out of band (bandpass filter 656-974 nm), which is why 25 filters give 24 bands.",
  "hyperdrive_dataset_effective_center_nm": "Effective centers of the Hyper-Drive dataset cubes, as reported by the ROS 1 pipeline contexts. Use these for the dataset.",
  "dataset_to_ibex_factor": "Multiply dataset (ROS 1, SWIR declared f/0) cube band values by this factor to match Ibex (ROS 2, f/2.8) processing. Measured 2026-10-22 with fnumber_test.py (median of f/0 / f/2.8 over 10 live frames, with dark and flat-field applied). VNIR is 1.0 (same f/1.4 in both)."
 },
 "bands_order_note": "VNIR virtual bands (ascending) then SWIR virtual bands (ascending), as output by the HSI Mosaic pipeline and stacked by Register_HSI.ipynb"
}